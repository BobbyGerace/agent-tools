#!/usr/bin/env bash
# Scan what is about to be published. This is the hook that matters: a bad commit can be amended,
# a pushed one cannot be unpublished.
#
# Enable with:  git config core.hooksPath scripts/hooks
#
# Git passes "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

[ -x scripts/check-public.sh ] || exit 0

ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a ref pushes nothing.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: no baseline to diff against, so scan everything it carries.
    echo "pre-push: new remote branch — scanning all tracked files"
    ./scripts/check-public.sh || status=1
  else
    echo "pre-push: scanning $remote_sha..$local_sha"
    ./scripts/check-public.sh --range "$remote_sha..$local_sha" || status=1
  fi
done

if [ "$status" -ne 0 ]; then
  cat >&2 <<'EOF'

pre-push: refusing the push.

This repo is public. Anything pushed is world-readable and permanently in history — a later
commit removing it does not unpublish it. Resolve the findings before pushing.

`git push --no-verify` bypasses this. If a finding is in a change you did not author, ask first.
EOF
  exit 1
fi
